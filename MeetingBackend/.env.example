# Google Gemini API Configuration (Used for meeting summary generation and follow-up Q&A)
GEMINI_API_KEY=your_actual_api_key
GEMINI_MODEL=gemini-2.5-flash

# Hugging Face Configuration (Used for pyannote speaker diarization)
HF_TOKEN=your_hugging_face_token

# Email Delivery Configuration (Used for sending meeting report PDFs to participants)
# Use console backend for local development/testing without real SMTP:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_email_app_password
DEFAULT_FROM_EMAIL=your_email@gmail.com

